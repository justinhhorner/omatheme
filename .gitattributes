# Line endings: LF everywhere (the repo is shared between Windows and macOS), in the repo and in
# working copies, regardless of a machine's core.autocrlf. Without this, Git for Windows'
# default autocrlf=true warns "LF will be replaced by CRLF" for every file written with LF.
* text=auto eol=lf

# Visual Studio expects CRLF in solution files.
*.sln text eol=crlf

# Binary assets: never convert or diff as text.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.bmp binary
*.icns binary
*.pdf binary
