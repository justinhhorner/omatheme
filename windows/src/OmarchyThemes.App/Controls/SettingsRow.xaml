<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OmarchyThemes.App.Controls.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icon | header + description | control, like a Settings app card. -->
    <Border Style="{StaticResource SettingsRowStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Margin="4,0,16,0"
                VerticalAlignment="Center"
                FontSize="20"
                Glyph="{x:Bind Glyph, Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Header, Mode=OneWay}" />
                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="{x:Bind Description, Mode=OneWay}" />
            </StackPanel>
            <!-- Stretch hands the control the whole cell, where its own alignment applies (as if it were in the Grid). -->
            <ContentPresenter
                Grid.Column="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind Action, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
