<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page-level spacing matching the Windows 11 Settings app. -->
    <Thickness x:Key="PageMargin">36,24,36,24</Thickness>
    <x:Double x:Key="PageMaxWidth">1400</x:Double>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

</ResourceDictionary>
