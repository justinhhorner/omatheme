<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmarchyThemes.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:OmarchyThemes.App.Controls"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Margin="{StaticResource PageMargin}">
            <TextBlock Margin="0,0,0,8" Style="{StaticResource PageTitleTextStyle}" Text="Settings" />

            <InfoBar
                Margin="0,8,0,0"
                IsOpen="{x:Bind ViewModel.Result.IsOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.Result.Message, Mode=OneWay}"
                Severity="{x:Bind ViewModel.Result.Severity, Mode=OneWay}"
                Title="{x:Bind ViewModel.Result.Title, Mode=OneWay}" />

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="One-click apply" />
            <TextBlock
                Margin="1,0,0,8"
                Style="{StaticResource SecondaryTextStyle}"
                Text="What &#8220;Set as desktop theme&#8221; changes. The Apply dialog starts with these choices too." />

            <c:SettingsRow
                Description="Set the theme's wallpaper on every monitor."
                Glyph="&#xE91B;"
                Header="Wallpaper">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox
                        x:Name="FitCombo"
                        MinWidth="120"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Wallpaper fit"
                        IsEnabled="{x:Bind ViewModel.ApplyWallpaper, Mode=OneWay}"
                        SelectionChanged="FitCombo_SelectionChanged" />
                    <ToggleSwitch
                        MinWidth="0"
                        AutomationProperties.Name="Apply wallpaper"
                        IsOn="{x:Bind ViewModel.ApplyWallpaper, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </StackPanel>
            </c:SettingsRow>

            <c:SettingsRow
                Description="Switch Windows and apps to match the theme."
                Glyph="&#xE793;"
                Header="Light or dark mode">
                <ToggleSwitch
                    MinWidth="0"
                    AutomationProperties.Name="Apply light or dark mode"
                    IsOn="{x:Bind ViewModel.ApplyMode, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </c:SettingsRow>

            <c:SettingsRow
                Description="Use the theme's accent color. Windows has no official API for this, so some parts of Windows may only update after you sign out."
                Glyph="&#xE790;"
                Header="Accent color">
                <ToggleSwitch
                    MinWidth="0"
                    AutomationProperties.Name="Apply accent color"
                    IsOn="{x:Bind ViewModel.ApplyAccent, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </c:SettingsRow>

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Your original desktop" />
            <c:SettingsRow
                Description="{x:Bind ViewModel.RestoreDescription, Mode=OneWay}"
                Glyph="&#xE777;"
                Header="Restore my original desktop">
                <Button
                    Margin="12,0,0,0"
                    Command="{x:Bind ViewModel.RestoreOriginalCommand}"
                    Content="Restore" />
            </c:SettingsRow>

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Storage" />
            <c:SettingsRow
                Description="{x:Bind ViewModel.StorageText, Mode=OneWay}"
                Glyph="&#xE8B7;"
                Header="Downloaded themes">
                <Button
                    Margin="12,0,0,0"
                    Command="{x:Bind ViewModel.OpenDataFolderCommand}"
                    Content="Open folder" />
            </c:SettingsRow>
            <c:SettingsRow
                Description="{x:Bind ViewModel.CacheText, Mode=OneWay}"
                Glyph="&#xE74D;"
                Header="Cache">
                <Button
                    Margin="12,0,0,0"
                    Command="{x:Bind ViewModel.ClearCacheCommand}"
                    Content="Clear cache" />
            </c:SettingsRow>
            <c:SettingsRow
                Description="{x:Bind ViewModel.GitHubText}"
                Glyph="&#xE774;"
                Header="GitHub access" />

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="About" />
            <c:SettingsRow
                Description="See the introduction to Omarchy Themes again."
                Glyph="&#xE8BC;"
                Header="Welcome screen">
                <Button
                    Margin="12,0,0,0"
                    Click="ShowWelcome_Click"
                    Content="Show welcome" />
            </c:SettingsRow>
        </StackPanel>
    </ScrollViewer>
</Page>
