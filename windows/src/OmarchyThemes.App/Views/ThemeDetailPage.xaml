<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmarchyThemes.App.Views.ThemeDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:OmarchyThemes.App.Helpers"
    xmlns:vm="using:OmarchyThemes.App.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="KeyColorTemplate" x:DataType="vm:ColorChipViewModel">
            <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="36"
                    Height="36"
                    Background="{x:Bind Brush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Hex}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SwatchTemplate" x:DataType="vm:ColorChipViewModel">
            <Border
                Height="36"
                AutomationProperties.Name="{x:Bind Tooltip}"
                Background="{x:Bind Brush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind Tooltip}" />
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <Grid MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SidePanel.(Grid.Row)" Value="1" />
                            <Setter Target="SidePanel.(Grid.Column)" Value="0" />
                            <Setter Target="SidePanel.Margin" Value="0,8,0,0" />
                            <Setter Target="SideColumn.Width" Value="0" />
                            <Setter Target="Actions.(Grid.Row)" Value="1" />
                            <Setter Target="Actions.(Grid.Column)" Value="0" />
                            <Setter Target="Actions.Margin" Value="0,12,0,0" />
                            <Setter Target="Actions.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource TitleLargeTextBlockStyle}"
                        Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton
                            Margin="-12,0,0,0"
                            AutomationProperties.Name="Open the theme's GitHub repository"
                            NavigateUri="{x:Bind ViewModel.RepoUri, Mode=OneWay}"
                            ToolTipService.ToolTip="Open on GitHub">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                <TextBlock Text="{x:Bind ViewModel.RepoDisplay, Mode=OneWay}" />
                            </StackPanel>
                        </HyperlinkButton>
                        <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind h:Ui.VisibleIf(ViewModel.ModeText), Mode=OneWay}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ModeText, Mode=OneWay}" />
                        </Border>
                        <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Downloaded" />
                        </Border>
                        <Border Style="{StaticResource AccentBadgeStyle}" Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Current desktop theme" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="Actions"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="ApplyButton"
                        MinWidth="160"
                        AutomationProperties.Name="{x:Bind ViewModel.ApplyButtonText, Mode=OneWay}"
                        Click="Apply_Click"
                        IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                IsActive="{x:Bind ViewModel.IsApplying, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsApplying, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ApplyButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.DownloadCommand}"
                        Content="Download"
                        Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsInstalled), Mode=OneWay}" />
                    <Button AutomationProperties.Name="More options" ToolTipService.ToolTip="More options">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Click="OpenRepo_Click" Text="Open on GitHub">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.DownloadCommand}"
                                    Text="Download again"
                                    Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay}" />
                                <MenuFlyoutItem
                                    Click="Remove_Click"
                                    Text="Remove download"
                                    Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Progress + notifications -->
            <StackPanel Grid.Row="1" Spacing="8">
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.DownloadStatus, Mode=OneWay}" />
                            <ProgressBar
                                AutomationProperties.Name="Download progress"
                                IsIndeterminate="{x:Bind ViewModel.IsDownloadIndeterminate, Mode=OneWay}"
                                Maximum="100"
                                Value="{x:Bind ViewModel.DownloadPercent, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.CancelDownloadCommand}"
                            Content="Cancel" />
                    </Grid>
                </Border>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsResultOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.ResultSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" />

                <InfoBar
                    IsOpen="{x:Bind h:Ui.IsSet(ViewModel.ResolveError), Mode=OneWay}"
                    Message="{x:Bind ViewModel.ResolveError, Mode=OneWay}"
                    Severity="Error"
                    Title="Couldn't read this theme">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.ResolveCommand}" Content="Try again" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    IsOpen="{x:Bind h:Ui.IsSet(ViewModel.Notice), Mode=OneWay}"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    Severity="Informational" />
            </StackPanel>

            <!-- Body -->
            <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition x:Name="SideColumn" Width="2*" MaxWidth="440" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Image
                            AutomationProperties.Name="{x:Bind ViewModel.Name, Mode=OneWay}"
                            Source="{x:Bind ViewModel.Screenshot, Mode=OneWay}"
                            Stretch="Uniform" />
                    </Border>

                    <TextBlock
                        Style="{StaticResource SectionHeaderTextStyle}"
                        Text="{x:Bind ViewModel.WallpapersHeader, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasWallpapers, Mode=OneWay}" />
                    <TextBlock
                        Margin="1,0,0,8"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="Pick the wallpaper to use when applying this theme."
                        Visibility="{x:Bind ViewModel.HasWallpapers, Mode=OneWay}" />
                    <GridView
                        x:Name="WallpaperGrid"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Wallpapers, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedWallpaper, Mode=OneWay}"
                        SelectionChanged="WallpaperGrid_SelectionChanged"
                        SelectionMode="Single">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WallpaperItemViewModel">
                                <Grid
                                    Width="208"
                                    AutomationProperties.Name="{x:Bind FileName}"
                                    RowSpacing="4"
                                    ToolTipService.ToolTip="{x:Bind FileName}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="117" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="4">
                                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="2,0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <StackPanel x:Name="SidePanel" Grid.Column="1">
                    <TextBlock Margin="1,0,0,8" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Colors" />

                    <StackPanel
                        Margin="0,16"
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsResolving, Mode=OneWay}">
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsResolving, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Reading theme from GitHub…" />
                    </StackPanel>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind h:Ui.IsSet(ViewModel.PaletteError), Mode=OneWay}"
                        Message="{x:Bind ViewModel.PaletteError, Mode=OneWay}"
                        Severity="Warning" />

                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowPalette, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <ItemsRepeater ItemTemplate="{StaticResource KeyColorTemplate}" ItemsSource="{x:Bind ViewModel.KeyColors, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="12"
                                        MinItemWidth="150"
                                        MinRowSpacing="12" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>

                            <ItemsRepeater ItemTemplate="{StaticResource SwatchTemplate}" ItemsSource="{x:Bind ViewModel.Swatches, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MaximumRowsOrColumns="8"
                                        MinColumnSpacing="6"
                                        MinItemWidth="32"
                                        MinRowSpacing="6" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Margin="1,16,0,0"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap">
                        Windows uses the wallpaper, the light/dark mode and the accent color. Terminal and editor colors are shown for reference.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
