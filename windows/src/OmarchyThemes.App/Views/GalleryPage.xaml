<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmarchyThemes.App.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:OmarchyThemes.App.Helpers"
    xmlns:vm="using:OmarchyThemes.App.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Uniform stretch keeps each card's proportions, so screenshots stay ~16:9. -->
        <UniformGridLayout
            x:Key="CardLayout"
            ItemsStretch="Uniform"
            MinColumnSpacing="16"
            MinItemHeight="214"
            MinItemWidth="280"
            MinRowSpacing="16" />

        <!-- A card is a Button: focusable, Enter/Space/click to open, and an Invoke pattern for UI Automation. -->
        <DataTemplate x:Key="ThemeCardTemplate" x:DataType="vm:ThemeCardViewModel">
            <Button
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                Click="Card_Click"
                Style="{StaticResource ThemeCardButtonStyle}"
                Tag="{x:Bind}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="7,7,0,0">
                        <Image Source="{x:Bind Screenshot}" Stretch="UniformToFill" />
                    </Grid>

                    <Grid Grid.Row="1" Padding="12,8,12,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind RepoDisplay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border Style="{StaticResource AccentBadgeStyle}" Visibility="{x:Bind IsActive, Mode=OneWay}">
                                <TextBlock
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Current" />
                            </Border>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE73E;"
                                ToolTipService.ToolTip="Downloaded"
                                Visibility="{x:Bind IsDownloaded, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="36,24,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActions.Margin" Value="0,12,0,0" />
                        <Setter Target="HeaderActions.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CurrentScreenshot.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Header: title + subtitle, search / filter / refresh -->
        <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Themes" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
            </StackPanel>

            <Grid
                x:Name="HeaderActions"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="260"
                    AutomationProperties.Name="Search themes"
                    PlaceholderText="Search themes"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="F"
                            Invoked="SearchAccelerator_Invoked"
                            Modifiers="Control" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>

                <ToggleButton
                    Grid.Column="1"
                    AutomationProperties.Name="Show downloaded themes only"
                    IsChecked="{x:Bind ViewModel.ShowDownloadedOnly, Mode=TwoWay}"
                    ToolTipService.ToolTip="Show downloaded themes only">
                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                </ToggleButton>

                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Refresh catalog"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Refresh from omarchy.org and GitHub (F5)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <Grid Width="16" Height="16">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsRefreshing), Mode=OneWay}" />
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1">
            <InfoBar
                Margin="0,0,0,12"
                IsOpen="{x:Bind h:Ui.IsSet(ViewModel.Notice), Mode=OneWay}"
                Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                Severity="Warning" />
            <InfoBar
                Margin="0,0,0,12"
                IsOpen="{x:Bind h:Ui.IsSet(ViewModel.DefaultThemesNotice), Mode=OneWay}"
                Message="{x:Bind ViewModel.DefaultThemesNotice, Mode=OneWay}"
                Severity="Warning"
                Title="Omarchy's themes are missing">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Try again" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- Two virtualizing repeaters sharing one scroll area; arrow keys move between cards. -->
            <ScrollViewer
                x:Name="ThemesScroller"
                Margin="0,0,-36,0"
                Padding="0,0,36,0"
                Visibility="{x:Bind ViewModel.HasThemes, Mode=OneWay}">
                <StackPanel Padding="0,0,0,36" XYFocusKeyboardNavigation="Enabled">
                    <!-- The theme on the desktop, with one-click switching between its wallpapers. -->
                    <StackPanel Margin="0,0,0,16" Visibility="{x:Bind ViewModel.ShowCurrentTheme, Mode=OneWay}">
                        <TextBlock
                            Margin="1,4,0,12"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Current theme" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="CurrentScreenshot"
                                    Width="240"
                                    Height="135"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                    CornerRadius="6">
                                    <Image Source="{x:Bind ViewModel.CurrentTheme.Screenshot, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock
                                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                                    Text="{x:Bind ViewModel.CurrentTheme.Name, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource AccentBadgeStyle}">
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="On your desktop" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.CurrentTheme.Details, Mode=OneWay}" />
                                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentTheme.Colors, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ColorChipViewModel">
                                                        <Border
                                                            Width="16"
                                                            Height="16"
                                                            Background="{x:Bind Brush}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            ToolTipService.ToolTip="{x:Bind Tooltip}" />
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Click="ViewCurrentTheme_Click"
                                            Content="View theme" />
                                    </Grid>

                                    <InfoBar
                                        IsOpen="{x:Bind ViewModel.CurrentTheme.IsResultOpen, Mode=TwoWay}"
                                        Message="{x:Bind ViewModel.CurrentTheme.ResultMessage, Mode=OneWay}"
                                        Severity="{x:Bind ViewModel.CurrentTheme.ResultSeverity, Mode=OneWay}"
                                        Title="{x:Bind ViewModel.CurrentTheme.ResultTitle, Mode=OneWay}" />

                                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CurrentTheme.HasWallpapers, Mode=OneWay}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Click a wallpaper to put it on your desktop." />
                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Auto"
                                            HorizontalScrollMode="Enabled"
                                            VerticalScrollBarVisibility="Disabled"
                                            VerticalScrollMode="Disabled">
                                            <ItemsRepeater Margin="0,0,0,12" ItemsSource="{x:Bind ViewModel.CurrentTheme.Wallpapers, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CurrentWallpaperViewModel">
                                                        <Button
                                                            Width="160"
                                                            Height="90"
                                                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                                            Click="CurrentWallpaper_Click"
                                                            Style="{StaticResource ThemeCardButtonStyle}"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                                            <Grid>
                                                                <Border CornerRadius="7">
                                                                    <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                                                </Border>
                                                                <!-- The wallpaper on the desktop now: accent ring + check. -->
                                                                <Border
                                                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                                    BorderThickness="2"
                                                                    CornerRadius="7"
                                                                    Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                                                <Border
                                                                    Width="22"
                                                                    Height="22"
                                                                    Margin="6"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom"
                                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                    CornerRadius="11"
                                                                    Visibility="{x:Bind IsCurrent, Mode=OneWay}">
                                                                    <FontIcon
                                                                        FontSize="12"
                                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                        Glyph="&#xE73E;" />
                                                                </Border>
                                                                <Grid
                                                                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                                                                    CornerRadius="7"
                                                                    Visibility="{x:Bind IsApplying, Mode=OneWay}">
                                                                    <ProgressRing
                                                                        Width="24"
                                                                        Height="24"
                                                                        IsActive="{x:Bind IsApplying, Mode=OneWay}" />
                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{x:Bind ViewModel.HasDefaultSection, Mode=OneWay}">
                        <StackPanel
                            Margin="1,4,0,12"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Included with Omarchy" />
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.DefaultThemes.Count, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                        <ItemsRepeater
                            ItemTemplate="{StaticResource ThemeCardTemplate}"
                            ItemsSource="{x:Bind ViewModel.DefaultThemes, Mode=OneWay}"
                            Layout="{StaticResource CardLayout}"
                            TabFocusNavigation="Once" />
                    </StackPanel>

                    <StackPanel Visibility="{x:Bind ViewModel.HasCommunitySection, Mode=OneWay}">
                        <StackPanel
                            Margin="1,28,0,12"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Community" />
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.CommunityThemes.Count, Mode=OneWay}" />
                            </Border>
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="From omarchy.org/themes" />
                        </StackPanel>
                        <ItemsRepeater
                            ItemTemplate="{StaticResource ThemeCardTemplate}"
                            ItemsSource="{x:Bind ViewModel.CommunityThemes, Mode=OneWay}"
                            Layout="{StaticResource CardLayout}"
                            TabFocusNavigation="Once" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Loading (first run, nothing cached) -->
            <StackPanel Style="{StaticResource EmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay}">
                <ProgressRing HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.ShowLoading, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="Loading themes…" />
            </StackPanel>

            <!-- Error with nothing to show -->
            <StackPanel Style="{StaticResource EmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}">
                <FontIcon Glyph="&#xE774;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Couldn't load themes" />
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextAlignment="Center" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="Try again"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <!-- Search / filter matched nothing -->
            <StackPanel Style="{StaticResource EmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.IsEmptyResult, Mode=OneWay}">
                <FontIcon Glyph="&#xE721;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.ResultText, Mode=OneWay}"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
