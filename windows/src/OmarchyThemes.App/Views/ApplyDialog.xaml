<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OmarchyThemes.App.Views.ApplyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Apply"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="400" Spacing="4">
        <TextBlock
            Margin="0,0,0,8"
            Style="{StaticResource SecondaryTextStyle}"
            Text="Choose what to change on your desktop." />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="WallpaperCheck" Content="Wallpaper" />
            <ComboBox
                x:Name="FitCombo"
                Grid.Column="1"
                MinWidth="120"
                VerticalAlignment="Center"
                AutomationProperties.Name="Wallpaper fit" />
        </Grid>

        <CheckBox x:Name="ModeCheck" />

        <CheckBox x:Name="AccentCheck">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border
                    x:Name="AccentSwatch"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4" />
                <TextBlock x:Name="AccentText" VerticalAlignment="Center" Text="Use the theme's accent color" />
            </StackPanel>
        </CheckBox>

        <TextBlock
            x:Name="UnavailableText"
            Margin="28,0,0,0"
            Style="{StaticResource TertiaryCaptionTextStyle}"
            Visibility="Collapsed" />

        <CheckBox
            x:Name="RememberCheck"
            Margin="0,12,0,0"
            Content="Use these choices for one-click apply" />

        <TextBlock
            x:Name="Footnote"
            Margin="0,8,0,0"
            Style="{StaticResource TertiaryCaptionTextStyle}" />
    </StackPanel>
</ContentDialog>
