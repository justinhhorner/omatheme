<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmarchyThemes.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel
            MaxWidth="560"
            Margin="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">

            <Image Width="96" Height="96" Source="ms-appx:///Assets/AppIcon.png" HorizontalAlignment="Center" />

            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource TitleLargeTextBlockStyle}"
                Text="Omarchy Themes" />

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap">
                Browse the themes that come with Omarchy, DHH's opinionated Linux setup, and the ones its community makes, and bring their wallpapers and colors to your Windows desktop. Nothing changes until you pick a theme and choose Apply.
            </TextBlock>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <HyperlinkButton Content="omarchy.org" NavigateUri="https://omarchy.org" />
                <HyperlinkButton Content="Omarchy on GitHub" NavigateUri="https://github.com/basecamp/omarchy" />
            </StackPanel>

            <Button
                x:Name="BrowseButton"
                MinWidth="200"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Click="BrowseButton_Click"
                Content="Browse Themes"
                Style="{StaticResource AccentButtonStyle}" />

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Not affiliated with Omarchy or 37signals. Themes belong to their authors." />
        </StackPanel>
    </ScrollViewer>
</Page>
