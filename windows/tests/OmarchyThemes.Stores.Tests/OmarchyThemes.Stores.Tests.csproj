<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OmarchyThemes.Stores\OmarchyThemes.Stores.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core's fakes (HTTP, downloader, desktop backend, snapshots, clock), shared rather than copied. -->
    <Compile Include="..\OmarchyThemes.Core.Tests\TestSupport\Fakes.cs" Link="TestSupport\Fakes.cs" />
    <!-- Shared with the macOS tests; see fixtures/ at the repo root. -->
    <None Include="..\..\..\fixtures\**\*" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
